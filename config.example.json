{
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "paths": {
    "photos": "photos",
    "stacks": "stacks"
  },
  "storage": {
    "target": "sd",
    "max_used_pct": 80
  },
  "filename_pattern": "{dt:%Y%m%d_%H%M%S}_{label}",
  "next_seq": 1,
  "image_format": "png",
  "png_compress_level": 3,
  "jpeg_quality": 95,
  "save_metadata": true,
  "persist_controls": true,
  "controls": {},
  "camera": {
    "index": 0,
    "preview_mode": "fast",
    "still_size": null,
    "preview_size": [
      1024,
      768
    ],
    "buffer_count": 2,
    "save_queue": 2,
    "compress_workers": 0,
    "lock_exposure_in_stacks": true
  },
  "processing": {
    "mode": "idle",
    "idle_minutes": 5
  },
  "focus_stack": {
    "method": "halofree",
    "halofree_threshold": 40,
    "halofree_band": 40,
    "binary": "",
    "output_format": "png",
    "consistency": 2,
    "denoise": 1.0,
    "threads": "",
    "batchsize": 4,
    "jpgquality": 100,
    "reference": "",
    "remove_bg": "",
    "global_align": false,
    "full_resolution_align": false,
    "no_whitebalance": false,
    "no_contrast": false,
    "no_transform": false,
    "no_align": false,
    "align_keep_size": false,
    "nocrop": false,
    "no_opencl": true,
    "depthmap": false,
    "view3d": false,
    "verbose": false,
    "extra_args": "",
    "delete_frames": true
  },
  "sweep": {
    "start": 2.0,
    "end": 6.0,
    "steps": 10,
    "settle_ms": 400
  },
  "upload": {
    "auto_drive": true,
    "auto_nas": false,
    "rclone_remote": "gdrive:MiniatureStudio",
    "nas_path": "/mnt/nas/miniaturestudio",
    "nas_require_mount": true,
    "stack_frames": false
  },
  "ui": {
    "pinned_controls": null
  },
  "crop": {
    "enabled": false,
    "aspect": "3:4",
    "size": 1.0,
    "cx": 0.5,
    "cy": 0.5,
    "x": 0.0,
    "y": 0.0,
    "w": 1.0,
    "h": 1.0
  }
}
