#!/usr/bin/env python3
"""Root helper for MiniatureStudio: mount a NAS share or a USB disk persistently (fstab).

Installed by install.sh as /usr/local/sbin/miniaturestudio-mount (root-owned) with a
sudoers rule for the service user. Usage (JSON on stdin, JSON on stdout):

    miniaturestudio-mount mount    {"type": "smb"|"nfs", "server", "share", "username",
                               "password", "domain", "version", "mount_point"}
    miniaturestudio-mount unmount
    miniaturestudio-mount status

    miniaturestudio-mount usb-mount   {"uuid": "..."}   use this USB partition for photos
    miniaturestudio-mount usb-remount                   re-mount the configured disk (replugged)
    miniaturestudio-mount usb-eject                     unmount, keep it configured
    miniaturestudio-mount usb-remove                    unmount and forget it
    miniaturestudio-mount usb-status

    miniaturestudio-mount camera-set  {"sensor": "auto"|"imx519"|"arducam-64mp"|..., "port": ""|"cam0"|"cam1"}
    miniaturestudio-mount camera-status                 camera lines in config.txt (reboot to apply)

One NAS share and one USB disk are managed; their fstab lines are marked with
MARKER / USB_MARKER.
Inputs are validated strictly because this runs as root.
"""
import json
import os
import re
import subprocess
import sys

FSTAB = "/etc/fstab"
CRED_DIR = "/etc/miniaturestudio"
CRED_FILE = f"{CRED_DIR}/nas.cred"
STATE_FILE = f"{CRED_DIR}/nas.json"
MARKER = "# miniaturestudio-nas"
USB_MARKER = "# miniaturestudio-usb"
USB_STATE_FILE = f"{CRED_DIR}/usb.json"
USB_MOUNT = "/mnt/miniaturestudio-usb"
UUID_RE = re.compile(r"^[A-Fa-f0-9-]{4,36}$")
USB_FSTYPES = {"ext4", "vfat", "exfat", "ntfs"}

HOST_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9.-]{0,252})$|^\[?[0-9A-Fa-f:.]+\]?$")
SHARE_RE = re.compile(r"^[A-Za-z0-9._ $/-]{1,200}$")
# One plain folder name under /mnt: starts with a letter or digit, so "." and ".."
# (which would mean /mnt or /) can never match.
MOUNT_RE = re.compile(r"^/mnt/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
USER_RE = re.compile(r"^[^\n\r,=]{0,128}$")
VERSION_RE = re.compile(r"^(|1\.0|2\.0|2\.1|3\.0|3\.02|3\.1\.1|3)$")


def out(data, code=0):
    print(json.dumps(data))
    sys.exit(code)


def fail(msg):
    out({"error": msg}, 1)


def read_fstab():
    with open(FSTAB, encoding="utf-8") as f:
        return f.read().splitlines()


def write_fstab(lines):
    tmp = FSTAB + ".miniaturestudio.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, FSTAB)


def strip_entry(lines, marker=MARKER):
    """Drop our marker line and the fstab line right after it."""
    result, skip = [], False
    for line in lines:
        if skip:
            skip = False
            continue
        if line.strip() == marker:
            skip = True
            continue
        result.append(line)
    return result


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def is_mounted(path):
    return os.path.ismount(path)


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def fstab_escape(text):
    return text.replace("\\", "\\134").replace(" ", "\\040").replace("\t", "\\011")


def do_unmount(state):
    if state:
        unit = run("systemd-escape", "--path", state["mount_point"]).stdout.strip()
        if unit:
            run("systemctl", "stop", f"{unit}.automount", f"{unit}.mount")
        if is_mounted(state["mount_point"]):
            if run("umount", state["mount_point"]).returncode != 0:
                run("umount", "-l", state["mount_point"])
    write_fstab(strip_entry(read_fstab()))
    for path in (CRED_FILE, STATE_FILE):
        if os.path.exists(path):
            os.remove(path)
    run("systemctl", "daemon-reload")


def load_usb_state():
    try:
        with open(USB_STATE_FILE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def usb_unmount():
    if is_mounted(USB_MOUNT):
        run("sync")
        if run("umount", USB_MOUNT).returncode != 0:
            fail("the disk is busy — wait for background saving to finish and try again")


def usb_action(action):
    state = load_usb_state()
    if action == "usb-status":
        out({"configured": bool(state), "mounted": is_mounted(USB_MOUNT), **(state or {})})
    if action == "usb-remount":
        if not state:
            fail("no USB disk configured")
        if not is_mounted(USB_MOUNT):
            r = run("mount", USB_MOUNT)
            if r.returncode != 0:
                fail("USB disk not connected: " + (r.stderr or r.stdout).strip())
        out({"configured": True, "mounted": True, **state})
    if action == "usb-eject":
        usb_unmount()
        out({"configured": bool(state), "mounted": False, **(state or {})})
    if action == "usb-remove":
        usb_unmount()
        write_fstab(strip_entry(read_fstab(), USB_MARKER))
        if os.path.exists(USB_STATE_FILE):
            os.remove(USB_STATE_FILE)
        run("systemctl", "daemon-reload")
        out({"configured": False, "mounted": False})
    if action != "usb-mount":
        fail("unknown usb action")

    try:
        req = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        fail("invalid JSON")
    uuid = (req.get("uuid") or "").strip()
    if not UUID_RE.match(uuid):
        fail("invalid UUID")
    device = run("blkid", "-U", uuid).stdout.strip()
    if not device.startswith("/dev/"):
        fail("disk not found — is it plugged in?")
    fstype = run("blkid", "-s", "TYPE", "-o", "value", device).stdout.strip()
    if fstype not in USB_FSTYPES:
        fail(f"unsupported filesystem {fstype!r} (use ext4, exFAT, FAT32 or NTFS)")
    # Never take over the disk the system itself runs from.
    for mp in ("/", "/boot", "/boot/firmware"):
        src = run("findmnt", "-n", "-o", "SOURCE", mp).stdout.strip()
        if src and os.path.realpath(src) == os.path.realpath(device):
            fail("that is the system disk")
    parent = run("lsblk", "-no", "PKNAME", device).stdout.strip() or os.path.basename(device)
    if run("lsblk", "-dno", "TRAN", f"/dev/{parent}").stdout.strip() != "usb":
        fail("not a USB disk")

    uid = int(os.environ.get("SUDO_UID", "1000"))
    gid = int(os.environ.get("SUDO_GID", "1000"))
    # nofail + short timeout: a missing disk never blocks booting.
    common = "noatime,nofail,x-systemd.device-timeout=5s"
    if fstype == "ext4":
        fs, opts = "ext4", f"defaults,{common}"
    elif fstype == "ntfs":
        if not os.path.exists("/usr/bin/ntfs-3g") and not os.path.exists("/bin/ntfs-3g"):
            fail("ntfs-3g is not installed (sudo apt install ntfs-3g)")
        fs, opts = "ntfs-3g", f"uid={uid},gid={gid},umask=0022,{common}"
    else:  # vfat / exfat have no Unix owners: map everything to the service user
        fs, opts = fstype, f"uid={uid},gid={gid},umask=0022,{common}"

    # Replace a previously configured disk.
    if is_mounted(USB_MOUNT):
        usb_unmount()
    # Unmount wherever the desktop/udisks may have mounted it.
    for mp in run("findmnt", "-n", "-o", "TARGET", device).stdout.split():
        run("umount", mp)
    os.makedirs(USB_MOUNT, exist_ok=True)
    lines = strip_entry(read_fstab(), USB_MARKER)
    write_fstab(lines + [USB_MARKER, f"UUID={uuid} {USB_MOUNT} {fs} {opts} 0 0"])
    run("systemctl", "daemon-reload")
    r = run("mount", USB_MOUNT)
    if r.returncode != 0 or not is_mounted(USB_MOUNT):
        write_fstab(strip_entry(read_fstab(), USB_MARKER))
        run("systemctl", "daemon-reload")
        fail("mount failed: " + ((r.stderr or r.stdout).strip() or "unknown error"))
    data = os.path.join(USB_MOUNT, "MiniatureStudio")
    os.makedirs(data, exist_ok=True)
    if fstype == "ext4":
        os.chown(data, uid, gid)
    label = run("blkid", "-s", "LABEL", "-o", "value", device).stdout.strip()
    new_state = {"uuid": uuid, "fstype": fstype, "label": label, "mount_point": USB_MOUNT}
    os.makedirs(CRED_DIR, mode=0o700, exist_ok=True)
    with open(USB_STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(new_state, f)
    out({"configured": True, "mounted": True, **new_state})


# ---------------------------------------------------------------- camera sensor overlay
# Official cameras are auto-detected (camera_auto_detect=1). Third-party sensors such
# as Arducam's 16MP (IMX519) and 64MP need camera_auto_detect=0 plus a dtoverlay.
CAMERA_MARKER_BEGIN = "# miniaturestudio-camera begin"
CAMERA_MARKER_END = "# miniaturestudio-camera end"
CAMERA_OVERLAYS = {"imx519", "arducam-64mp", "ov64a40", "imx477", "imx708", "imx219", "ov5647",
                   "imx296", "imx290", "imx378"}
CAMERA_PORTS = {"", "cam0", "cam1"}
DISABLED_AUTODETECT = "#camera_auto_detect=1  # disabled by MiniatureStudio"


def config_txt_path():
    for path in ("/boot/firmware/config.txt", "/boot/config.txt"):
        if os.path.exists(path):
            return path
    fail("config.txt not found")


def read_camera_block(lines):
    inside, overlays = False, []
    for line in lines:
        if line.strip() == CAMERA_MARKER_BEGIN:
            inside = True
        elif line.strip() == CAMERA_MARKER_END:
            inside = False
        elif inside and line.startswith("dtoverlay="):
            overlays.append(line.split("=", 1)[1])
    return overlays


def camera_action(action):
    path = config_txt_path()
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    if action == "camera-status":
        out({"config": path, "overlays": read_camera_block(lines),
             "autodetect": not any(l.strip() == DISABLED_AUTODETECT for l in lines)})
    if action != "camera-set":
        fail("unknown camera action")
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        fail("invalid JSON")
    sensor = (req.get("sensor") or "auto").strip()
    port = (req.get("port") or "").strip()
    if sensor != "auto" and sensor not in CAMERA_OVERLAYS:
        fail(f"unknown sensor {sensor!r}")
    if port not in CAMERA_PORTS:
        fail("port must be empty, cam0 or cam1")

    # Remove our previous block and re-enable auto-detection lines we disabled.
    cleaned, inside = [], False
    for line in lines:
        s = line.strip()
        if s == CAMERA_MARKER_BEGIN:
            inside = True
            continue
        if s == CAMERA_MARKER_END:
            inside = False
            continue
        if inside:
            continue
        cleaned.append("camera_auto_detect=1" if s == DISABLED_AUTODETECT else line)
    if sensor != "auto":
        cleaned = [DISABLED_AUTODETECT if l.strip().startswith("camera_auto_detect=") and not l.strip().startswith("#")
                   else l for l in cleaned]
        overlay = sensor + (f",{port}" if port else "")
        cleaned += [CAMERA_MARKER_BEGIN, "[all]", "camera_auto_detect=0", f"dtoverlay={overlay}", CAMERA_MARKER_END]
    backup = path + ".miniaturestudio.bak"
    if not os.path.exists(backup):
        with open(path, encoding="utf-8") as src, open(backup, "w", encoding="utf-8") as dst:
            dst.write(src.read())
    tmp = path + ".miniaturestudio.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(cleaned) + "\n")
    os.replace(tmp, path)
    run("sync")
    out({"config": path, "overlays": read_camera_block(cleaned), "backup": backup, "reboot_required": True})


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action.startswith("usb-"):
        usb_action(action)
    if action.startswith("camera-"):
        camera_action(action)
    state = load_state()

    if action == "status":
        if not state:
            out({"configured": False})
        out({"configured": True, "mounted": is_mounted(state["mount_point"]), **state})

    if action == "unmount":
        do_unmount(state)
        out({"configured": False, "mounted": False})

    if action != "mount":
        fail("usage: miniaturestudio-mount mount|unmount|status|usb-mount|usb-remount|usb-eject|usb-remove|usb-status")

    try:
        req = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        fail("invalid JSON")
    kind = req.get("type", "smb")
    server = (req.get("server") or "").strip()
    share = (req.get("share") or "").strip().strip("/")
    mount_point = (req.get("mount_point") or "/mnt/nas").strip().rstrip("/")
    username = req.get("username") or ""
    password = req.get("password") or ""
    domain = req.get("domain") or ""
    version = (req.get("version") or "").strip()

    if kind not in ("smb", "nfs"):
        fail("type must be smb or nfs")
    if not HOST_RE.match(server):
        fail("invalid server name / IP")
    if not SHARE_RE.match(share) or ".." in share:
        fail("invalid share name")
    if not MOUNT_RE.match(mount_point) or mount_point == USB_MOUNT:
        fail("mount point must be /mnt/<name> (letters, digits, . _ -), not the USB disk's folder")
    if not USER_RE.match(username) or not USER_RE.match(domain) or "\n" in password:
        fail("invalid username / domain / password")
    if not VERSION_RE.match(version):
        fail("invalid SMB version")

    # The share is written as the user who ran sudo (the MiniatureStudio service user).
    uid = int(os.environ.get("SUDO_UID", "1000"))
    gid = int(os.environ.get("SUDO_GID", "1000"))

    do_unmount(state)  # replace any previous MiniatureStudio share
    os.makedirs(mount_point, exist_ok=True)
    common = "nofail,_netdev,x-systemd.automount,x-systemd.mount-timeout=30"

    if kind == "smb":
        if not os.path.exists("/sbin/mount.cifs") and not os.path.exists("/usr/sbin/mount.cifs"):
            fail("cifs-utils is not installed (sudo apt install cifs-utils)")
        os.makedirs(CRED_DIR, mode=0o700, exist_ok=True)
        fd = os.open(CRED_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(f"username={username}\npassword={password}\n")
            if domain:
                f.write(f"domain={domain}\n")
        opts = f"credentials={CRED_FILE},uid={uid},gid={gid},iocharset=utf8,file_mode=0664,dir_mode=0775"
        if version:
            opts += f",vers={version}"
        line = f"//{fstab_escape(server)}/{fstab_escape(share)} {mount_point} cifs {opts},{common} 0 0"
    else:
        if not os.path.exists("/sbin/mount.nfs") and not os.path.exists("/usr/sbin/mount.nfs"):
            fail("nfs-common is not installed (sudo apt install nfs-common)")
        line = f"{server}:/{fstab_escape(share)} {mount_point} nfs defaults,{common} 0 0"

    lines = strip_entry(read_fstab())
    write_fstab(lines + [MARKER, line])
    run("systemctl", "daemon-reload")
    r = run("mount", mount_point)
    if r.returncode != 0 or not is_mounted(mount_point):
        # x-systemd.automount: the first access triggers the real mount.
        run("ls", mount_point)
    if not is_mounted(mount_point) and run("findmnt", "-n", "-t", "cifs,nfs,nfs4", mount_point).returncode != 0:
        err = (r.stderr or r.stdout).strip() or "mount failed"
        do_unmount(None)
        fail(f"mount failed: {err}")

    new_state = {"type": kind, "server": server, "share": share, "mount_point": mount_point,
                 "username": username, "domain": domain, "version": version}
    os.makedirs(CRED_DIR, mode=0o700, exist_ok=True)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(new_state, f)
    out({"configured": True, "mounted": True, **new_state})


if __name__ == "__main__":
    main()
